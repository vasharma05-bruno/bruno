        age: 36
        admin: false
        tags:
          - beta
        address:
          city: London
    import_users:
      type: object
      properties: {}
    update_user:
      type: object
      properties:
        user:
          type: object
          properties:
            name:
              type: string
            role:
              type: string
      example:
        user:
          name: Ada
          role: admin
    upload_avatar:
      type: object
      properties:
        userId:
          type: string
          description: Owner of the avatar
        file:
          type: array
          items:
            type: string
          properties:
            '0':
              type: string
    submit_form:
      type: object
      properties:
        title:
          type: string
          description: Form title
        draft:
          type: string
  requestBodies:
    create_user:
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/create_user'
      description: ''
      required: true
    import_users:
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/import_users'
      description: ''
      required: true
    update_user:
      content:
        application/xml:
          schema:
            $ref: '#/components/schemas/update_user'
      description: ''
      required: true
    upload_avatar:
      content:
        multipart/form-data:
          schema:
            $ref: '#/components/schemas/upload_avatar'
      description: ''
      required: true
    submit_form:
      content:
        application/x-www-form-urlencoded:
          schema:
            $ref: '#/components/schemas/submit_form'
      description: ''
      required: true
  securitySchemes:
    create_user:
      type: http
      scheme: bearer
    update_user:
      type: http
      scheme: basic
    oauth_login:
      type: oauth2
      flows:
        authorizationCode:
          authorizationUrl: https://auth.test/authorize
          tokenUrl: https://auth.test/token
          scopes:
            read: ''
    password_login:
      type: oauth2
      flows:
        password:
          tokenUrl: https://auth.test/token
          scopes:
            write: ''
    service_token:
      type: oauth2
